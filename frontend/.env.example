# ==============================================================================
# CineBook Frontend - Environment Variables (.env)
# ==============================================================================
# Copy this file to .env or .env.local for local overrides.
# In local development, if VITE_API_BASE_URL is not set, it defaults to http://127.0.0.1:8000/api
#
# When deploying the frontend (e.g. on Render Static Site):
# Set this environment variable in the Render Dashboard to your deployed backend URL:
VITE_API_BASE_URL=https://your-cinebook-backend.onrender.com/api
