# ==============================================================================
# CineBook Root .gitignore
# ==============================================================================

# Environment variables & secrets (NEVER commit these!)
.env
.env.*
.env.local
!.env.example

# Databases
*.sqlite3
*.sqlite3-journal
backend/db.sqlite3

# Python bytecode & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
venv/
.venv/
env/
ENV/

# Static & Media output
backend/staticfiles/
backend/media/

# Node.js dependencies & build
node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE metadata
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
