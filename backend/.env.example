# ==============================================================================
# CineBook Backend - Environment Variables Configuration (.env)
# ==============================================================================
# Copy this file to .env for local overrides.
# NEVER commit your actual .env file or real secrets to GitHub!

# Django Security
# Generate a secure key in production (e.g. using: python -c 'import secrets; print(secrets.token_urlsafe(50))')
DJANGO_SECRET_KEY=your-long-secure-random-secret-key-here
DEBUG=True

# Allowed Hosts (comma-separated domains, e.g., your-api.onrender.com,localhost)
# On Render, .onrender.com and RENDER_EXTERNAL_HOSTNAME are automatically permitted
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Option A: Render PostgreSQL / Cloud Database (Recommended for Render)
# Render automatically provides DATABASE_URL when you attach a PostgreSQL database.
# Format: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=

# Option B: Local MySQL (Leave USE_MYSQL=False to use SQLite by default)
USE_MYSQL=False
DB_NAME=cinebook_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# -----------------------------------------------------------------------------
# CORS & Frontend Origins
# -----------------------------------------------------------------------------
# In local dev (DEBUG=True), all origins are accepted.
# In production (DEBUG=False), set your deployed frontend URL here:
FRONTEND_URL=https://your-cinebook-frontend.onrender.com
# Additional CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://your-cinebook-frontend.onrender.com,http://localhost:5173
# Additional CSRF trusted origins for Django Admin & session requests
CSRF_TRUSTED_ORIGINS=https://your-cinebook-frontend.onrender.com,https://your-cinebook-api.onrender.com

# -----------------------------------------------------------------------------
# Payment Configuration (Razorpay / Interactive Demo Simulator)
# -----------------------------------------------------------------------------
# Keep RAZORPAY_SIMULATED_MODE=True for safe interactive demo payments (no real money)
RAZORPAY_SIMULATED_MODE=True

# Optional: Razorpay Test Mode credentials (only required if connecting live test checkout)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayTestSecretKeyHere

# -----------------------------------------------------------------------------
# Seat Hold & Cancellation Policy
# -----------------------------------------------------------------------------
# Seat hold countdown in minutes before releasing unbooked seats
SEAT_HOLD_DURATION_MINUTES=5

# Hours before showtime after which tickets cannot be cancelled
CANCELLATION_CUTOFF_HOURS=2
